    function initColorCheck() {
        var chk = document.getElementById('colors-toggle');
        var pref = localStorage.getItem('anki_colors_pref');
        var isEnabled = pref === null ? true : (pref === 'true'); 
        if(chk) chk.checked = isEnabled;
        applyColors(isEnabled);
    }
    window.toggleColors = function(el) {
        var isEnabled = el.checked;
        localStorage.setItem('anki_colors_pref', isEnabled);
        applyColors(isEnabled);
    }
    function applyColors(isEnabled) {
        var container = document.querySelector('.anki-card-container');
        if(container) {
            if(isEnabled) container.classList.remove('disable-colors');
            else container.classList.add('disable-colors');
        }
    }

    window.manageStats = function() {
        var db = JSON.parse(localStorage.getItem('anki_stats_v1') || '{}');
        var data = db[cardId] || { ok: 0, nok: 0 };
        var choice = prompt("Gerenciar Stats (ID: " + cardId + ")\\n✅ " + data.ok + " | ❌ " + data.nok + "\\n\\n0 - Zerar\\n1 - Editar");
        if (choice === '0') { db[cardId] = { ok: 0, nok: 0 }; alert("Zerado."); }
        else if (choice === '1') {
            var o = prompt("Novos Acertos:", data.ok); var n = prompt("Novos Erros:", data.nok);
            if (o!==null&&n!==null) db[cardId] = { ok: parseInt(o)||0, nok: parseInt(n)||0 };
        }
        localStorage.setItem('anki_stats_v1', JSON.stringify(db));
        renderStats();
