    }

    function updateStats(id, isOk) {
        var db = JSON.parse(localStorage.getItem('anki_stats_v1') || '{}');
        if(!db[id]) db[id] = { ok: 0, nok: 0 };
        if(isOk) db[id].ok++; else db[id].nok++;
        localStorage.setItem('anki_stats_v1', JSON.stringify(db));
    }

    function renderStats() {
        var area = document.getElementById('stats-area');
        var show = localStorage.getItem('anki_show_stats_pref') === 'true';
        if(!show) { area.style.display = 'none'; return; }
        area.style.display = 'flex';
        var db = JSON.parse(localStorage.getItem('anki_stats_v1') || '{}');
        var data = db[cardId] || { ok: 0, nok: 0 };
        var total = data.ok + data.nok;
        var p = total === 0 ? 0 : Math.round((data.ok / total) * 100);
        document.getElementById('card-pie').style.setProperty('--p', p + '%');
        document.getElementById('txt-ok').innerText = 'Acertos: ' + data.ok + ' (' + p + '%)';
        document.getElementById('txt-nok').innerText = 'Erros: ' + data.nok + ' (' + (total===0 ? 0 : 100-p) + '%)';
    }

    window.toggleSettings = function() {
        var pnl = document.getElementById('settings-pnl');
        pnl.style.display = pnl.style.display === 'flex' ? 'none' : 'flex';
