                currentCardIndex = deck.length - 1;
                renderFields();
            }

            function deleteCurrentCard() {
                if (deck.length <= 1) return;
                if (confirm('Apagar?')) {
                    deck.splice(currentCardIndex, 1);
                    currentCardIndex = Math.max(0, currentCardIndex - 1);
                    renderFields();
                    localStorage.setItem('anki_deck_v34', JSON.stringify(deck));
                }
            }
            function switchTab(t, b) {
                document.querySelectorAll('.tab').forEach((x) => x.classList.remove('active'));
                document.querySelectorAll('.editor-container').forEach((x) => x.classList.remove('active'));
                b.classList.add('active');
                document.getElementById('editor-' + t).classList.add('active');
            }
            function openImportModal() {
                document.getElementById('import-modal').style.display = 'flex';
            }
            function closeImportModal() {
                document.getElementById('import-modal').style.display = 'none';
            }
            function showStatus(m) {
                const s = document.getElementById('status-msg');
                s.innerText = m;
                s.style.display = 'block';
                setTimeout(() => (s.style.display = 'none'), 3000);
            }

            async function startUltraProcess() {
                const file = document.getElementById('pdf-input').files[0];
                if (!file) return alert('Selecione o PDF.');
                const loading = document.getElementById('loading-ia');
                const lSub = document.getElementById('loading-subtext');
                const lBar = document.getElementById('main-progress');
                loading.style.display = 'flex';
                closeImportModal();

                try {
                    const buffer = await file.arrayBuffer();
                    const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;

                    let gabaritoText = '';
                    const startPageGab = Math.max(1, pdf.numPages - 2);
                    for (let p = startPageGab; p <= pdf.numPages; p++) {
                        const pg = await pdf.getPage(p);
                        const ct = await pg.getTextContent();
                        gabaritoText += ct.items.map((i) => i.str).join(' ');
                    }

                    const CHUNK_SIZE = 2;
                    let chunks = [];
                    for (let i = 1; i <= pdf.numPages; i += CHUNK_SIZE) chunks.push(i);

                    let completed = 0;
                    const processBlock = async (start) => {
                        let text = '';
                        for (let j = start; j < start + CHUNK_SIZE && j <= pdf.numPages; j++) {
                            const page = await pdf.getPage(j);
                            const content = await page.getTextContent();
                            text += `--- PAGE ${j} ---\n` + content.items.map((it) => it.str).join(' ') + '\n';
                        }

                        const prompt = `Atue como um Especialista de Elite em Análise de Questões.

REGRAS DE OURO:
1. **TEXTO LIMPO NA QUESTÃO:** Na pergunta e opções, mantenha o texto limpo, usando APENAS as cores Vermelha (Perigo) e Laranja (Dados). Use Azul apenas se for estritamente um termo técnico.
2. **RESUMO DO PROFESSOR (RICO):** No campo "Explicação Universal", use TODAS AS CORES disponíveis para criar um resumo estilo "mapa mental", rico e didático.
3. **FORMATO:** HTML <span> com classes.

TABELA DE GATILHOS (USO HÍBRIDO):

🔴 <span class='g-red'>[CRÍTICO]</span> (VERMELHO): Negação, Exceção, Proibição, Absolutos (Sempre/Nunca).
🟠 <span class='g-org'>[DADOS]</span> (LARANJA): Números, Prazos, Percentuais.
🔵 <span class='g-blue'>[CONCEITOS]</span> (AZUL): Termos Técnicos, Nomes de Leis (Use muito no Resumo).
🟣 <span class='g-purp'>[CONDIÇÃO]</span> (ROXO): Se, Caso, Desde que (Use muito no Resumo).
🟢 <span class='g-grn'>[FLEXÍVEL]</span> (VERDE): Pode, Em regra (Use muito no Resumo).

ESTRUTURA DE SAÍDA (JSON):
Extraia: ID, Banca, Matéria, Assunto, Texto Associado (Vazio), Questão (Com spans básicos), Opções (Com spans básicos), Resposta Correta (Letra), Explicação Universal (Com MUITOS spans variados).

Gabarito Ref: ${gabaritoText}. Contexto: ${text}`;

                        const res = await callGemini({
                            contents: [{ parts: [{ text: prompt }] }],
                            generationConfig: {
                                responseMimeType: 'application/json',
                                responseSchema: {
                                    type: 'ARRAY',
                                    items: {
                                        type: 'OBJECT',
                                        properties: {
                                            ID: { type: 'STRING' },
                                            Banca: { type: 'STRING' },
                                            Matéria: { type: 'STRING' },
                                            Assunto: { type: 'STRING' },
                                            'Texto Associado': { type: 'STRING' },
                                            Questão: { type: 'STRING' },
                                            'Opção 1 (A)': { type: 'STRING' },
                                            'Opção 2 (B)': { type: 'STRING' },
                                            'Opção 3 (C)': { type: 'STRING' },
                                            'Opção 4 (D)': { type: 'STRING' },
                                            'Opção 5 (E)': { type: 'STRING' },
                                            'Resposta Correta': { type: 'STRING' },
                                            'Explicação Universal': { type: 'STRING' }
                                        }
                                    }
                                }
                            }
                        });

                        completed++;
                        lBar.style.width = Math.round((completed / chunks.length) * 100) + '%';
                        lSub.innerText = `Processando bloco ${completed}/${chunks.length}...`;
                        return cleanAndParseJSON(res);
                    };

                    const BATCH_SIZE = 4;
                    let results = [];
                    for (let i = 0; i < chunks.length; i += BATCH_SIZE) {
                        const batch = chunks.slice(i, i + BATCH_SIZE);
                        const batchRes = await Promise.all(batch.map((s) => processBlock(s)));
                        batchRes.forEach((r) => {
                            if (Array.isArray(r)) results.push(...r.map((item) => ({ ...defaultCardStructure, ...item })));
                        });
                    }

                    const seenIds = new Set();
                    const uniqueResults = results.filter((r) => {
                        if (!r.ID || seenIds.has(r.ID)) return false;
                        seenIds.add(r.ID);
                        return true;
                    });

                    deck = [...deck, ...uniqueResults];
                    localStorage.setItem('anki_deck_v34', JSON.stringify(deck));
                    currentCardIndex = Math.max(0, deck.length - uniqueResults.length);
                    renderFields();
                    showStatus(`${uniqueResults.length} questões extraídas com sucesso!`);
                } catch (e) {
                    console.error(e);
                    alert('Erro: ' + e.message);
                } finally {
                    loading.style.display = 'none';
                }
            }

            async function callGemini(payload) {
                let retries = 0;
                while (retries < 5) {
                    try {
                        const res = await fetch(
                            `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`,
                            {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            }
                        );
                        const d = await res.json();
                        if (!d.candidates || !d.candidates[0].content) throw new Error('API Error');
                        return d.candidates[0].content.parts[0].text;
                    } catch (e) {
                        retries++;
                        await new Promise((x) => setTimeout(x, 2000 * Math.pow(2, retries)));
                    }
                }
                throw new Error('Falha na conexão com IA');
            }

            function exportStructuredCSV() {
                if (deck.length === 0) return alert('Vazio.');
                const headers = [
                    'ID',
                    'Banca',
                    'Matéria',
                    'Assunto',
                    'Texto Associado',
                    'Questão',
                    'Opção 1 (A)',
                    'Opção 2 (B)',
                    'Opção 3 (C)',
                    'Opção 4 (D)',
                    'Opção 5 (E)',
                    'Resposta Correta',
                    'Explicação Universal'
                ];
                let csv = headers.join(';') + '\n';
                deck.forEach((d) => {
                    const row = headers.map((h) => {
                        let val = d[h] || '';
                        if (h === 'Resposta Correta') {
                            let match = val.toString().toUpperCase().match(/[ABCDE]/);
                            if (match) val = match[0];
                        }
                        return `"${val.toString().replace(/"/g, '""').replace(/\n/g, ' ')}"`;
                    });
                    csv += row.join(';') + '\n';
                });
                const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'simulado_anki_13_colunas.csv';
                a.click();
            }

            window.onload = init;
        </script>
    </body>
</html>
