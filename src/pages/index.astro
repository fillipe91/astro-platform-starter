            function updatePreview() {
                const css = document.getElementById('code-css').value;
                const html =
                    currentSide === 'front' ? document.getElementById('code-front').value : document.getElementById('code-back').value;
                document.getElementById('style-injection').innerHTML = `<style>${css}</style>`;

