                    <span
                        id="loading-text"
                        style="font-weight: bold; font-size: 16px; margin-bottom: 10px;"
                        >Analisando Simulado...</span
                    >
                    <div class="progress-box"><div id="main-progress" class="progress-bar"></div></div>
                    <span id="loading-subtext" style="font-size: 12px; margin-top: 5px; color: #aaa;"
                        >Extraindo questões e gerando resumo visual...</span
                    >
                </div>
                <div id="style-injection"></div>
                <div id="anki-wrapper" style="width: 100%; display: flex; justify-content: center;">
                    <div id="card-preview"></div>
                </div>
            </div>
        </div>

        <div id="import-modal">
