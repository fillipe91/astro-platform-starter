    var canScore = sessionStorage.getItem("anki_can_score_" + cardId) === "true";

    var elCorrect = document.getElementById('res-container-' + correctLetter);
    if(elCorrect) elCorrect.classList.add('correto');

    var banner = document.getElementById('res-banner');

    if(userAns === correctLetter) {
        banner.innerText = "🎉 Acertou!";
        banner.className = "banner-resultado acerto";
        if(canScore) {
            updateStats(cardId, true);
            sessionStorage.setItem("anki_can_score_" + cardId, "false"); 
        }
    } else {
        if(userAns) {
            banner.innerText = "❌ Errou! Você marcou " + userAns;
            banner.className = "banner-resultado erro";
            var elWrong = document.getElementById('res-container-' + userAns);
            if(elWrong) elWrong.classList.add('errado');
            if(canScore) {
                updateStats(cardId, false);
                sessionStorage.setItem("anki_can_score_" + cardId, "false");
            }
        } else {
            banner.innerText = "👁️ Apenas Visualizando";
            banner.style.color = "#888";
