<script>
    var cardId = "{{ID}}"; 

    function selectAnswer(opt) {
        document.querySelectorAll('.container-opcao').forEach(el => el.classList.remove('selected-temp'));
        var el = document.getElementById('opt-'+opt);
        if(el) el.classList.add('selected-temp');
        sessionStorage.setItem("anki_ans_" + cardId, opt);
        sessionStorage.setItem("anki_can_score_" + cardId, "true");
    }

    window.handleRisk = function(e, el) {
        if (e.button === 1 || e.type === 'dblclick') {
            e.preventDefault();
            e.stopPropagation(); 
            el.classList.toggle('riscado');
            return false;
        }
    }

    var saved = sessionStorage.getItem("anki_ans_" + cardId);
    if(saved) {
        var el = document.getElementById('opt-'+saved);
        if(el) el.classList.add('selected-temp');
    }

    window.toggleEl = function(id, btn, t1, t2) {
        var el = document.getElementById(id);
        if(el.style.display === 'block') { el.style.display='none'; btn.innerText=t1; }
        else { el.style.display='block'; btn.innerText=t2; }
    }

    /* CONFIGURAÇÕES GERAIS */
    window.toggleSettings = function() {
        var pnl = document.getElementById('settings-pnl');
        pnl.style.display = pnl.style.display === 'flex' ? 'none' : 'flex';
    }

    // Gerenciamento de Cores
    function initColorCheck() {
        var chk = document.getElementById('colors-toggle');
        var pref = localStorage.getItem('anki_colors_pref');
        var isEnabled = pref === null ? true : (pref === 'true'); // Default true
        if(chk) chk.checked = isEnabled;
        applyColors(isEnabled);
    }
    window.toggleColors = function(el) {
        var isEnabled = el.checked;
        localStorage.setItem('anki_colors_pref', isEnabled);
        applyColors(isEnabled);
    }
    function applyColors(isEnabled) {
        var container = document.querySelector('.anki-card-container');
        if(container) {
            if(isEnabled) container.classList.remove('disable-colors');
            else container.classList.add('disable-colors');
        }
    }

    window.manageStats = function() {
        var db = JSON.parse(localStorage.getItem('anki_stats_v1') || '{}');
        var data = db[cardId] || { ok: 0, nok: 0 };
        var choice = prompt("Gerenciar Stats (ID: " + cardId + ")\\n✅ " + data.ok + " | ❌ " + data.nok + "\\n\\n0 - Zerar\\n1 - Editar");
        if (choice === '0') { db[cardId] = { ok: 0, nok: 0 }; alert("Zerado."); }
        else if (choice === '1') {
            var o = prompt("Novos Acertos:", data.ok); var n = prompt("Novos Erros:", data.nok);
            if (o!==null&&n!==null) db[cardId] = { ok: parseInt(o)||0, nok: parseInt(n)||0 };
        }
        localStorage.setItem('anki_stats_v1', JSON.stringify(db));
        renderStats();
    };

    var currentZoom = parseFloat(localStorage.getItem('anki_zoom_pref')) || 1;
    function applyZoom() { document.querySelector('.conteudo').style.zoom = currentZoom; }
    window.zoom = function(val) {
        currentZoom += val;
        if(currentZoom < 0.5) currentZoom = 0.5;
        localStorage.setItem('anki_zoom_pref', currentZoom);
        applyZoom();
    }
    applyZoom();

    function initStatsCheck() {
        var chk = document.getElementById('stats-toggle');
        if(chk) chk.checked = localStorage.getItem('anki_show_stats_pref') === 'true';
    }
    window.toggleStats = function(el) { localStorage.setItem('anki_show_stats_pref', el.checked); renderStats(); }
    initStatsCheck();

    function initShuffle() {
        var chk = document.getElementById('shuffle-toggle');
        var shouldShuffle = localStorage.getItem('anki_shuffle_pref') === 'true';
        if(chk) chk.checked = shouldShuffle;
        if(shouldShuffle) {
            var quizArea = document.getElementById('quiz-area');
            var options = Array.from(quizArea.children);
            var letters = ['A.', 'B.', 'C.', 'D.', 'E.'];
            for (var i = options.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                [options[i], options[j]] = [options[j], options[i]];
            }
            options.forEach((el, index) => {
                quizArea.appendChild(el);
                var letterDiv = el.querySelector('.letra-coluna');
                if(letterDiv && letters[index]) letterDiv.innerText = letters[index];
            });
        }
    }
    window.toggleShuffle = function(el) { localStorage.setItem('anki_shuffle_pref', el.checked); location.reload(); }

    // Inits
    initShuffle();
    initColorCheck();

<\/script>`;

